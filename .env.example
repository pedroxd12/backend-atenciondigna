PORT=3001

# Password para el login de staff en dashboard.
# Railway: configuralo como variable de entorno.
# Opcional: STAFF_LOGIN_PASSWORDS permite varias claves separadas por coma.
STAFF_LOGIN_PASSWORD=demo-staff-2026
STAFF_LOGIN_PASSWORDS=

# URL del microservicio IA (FastAPI). En local apunta a uvicorn,
# en producción a la URL pública de Railway.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
