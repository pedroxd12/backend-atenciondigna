generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Estado {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(80)
  clave_inegi String   @unique @db.VarChar(5)
  ciudades    Ciudad[]

  @@map("estados")
}

model Ciudad {
  id          Int        @id @default(autoincrement())
  id_estado   Int
  nombre      String     @db.VarChar(120)
  clave_inegi String?    @db.VarChar(10)
  estado      Estado     @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales  Sucursal[]

  @@map("ciudades")
}

model Sucursal {
  id                             Int                       @id @default(autoincrement())
  id_ciudad                      Int
  nombre                         String                    @db.VarChar(150)
  direccion                      String?
  telefono                       String?                   @db.VarChar(20)
  email                          String?                   @db.VarChar(150)
  latitud                        Decimal?                  @db.Decimal(10, 7)
  longitud                       Decimal?                  @db.Decimal(10, 7)
  ubicacion                      Unsupported("geography")?
  mapa_geojson                   Json?
  hora_apertura                  DateTime?                 @db.Time(6)
  hora_cierre                    DateTime?                 @db.Time(6)
  activa                         Boolean                   @default(true)
  created_at                     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  cola_atencion                  ColaAtencion[]
  historico_promedios            HistoricoPromedio[]
  predicciones_ia                PrediccionIA[]
  reservaciones                  Reservacion[]
  reservaciones_servicios        ReservacionServicio[]
  ciudad                         Ciudad                    @relation(fields: [id_ciudad], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales_consultorios        SucursalConsultorio[]
  sucursales_horarios_especiales SucursalHorarioEspecial[]
  staff                          UsuarioStaff[]

  @@index([ubicacion], map: "idx_sucursales_ubicacion", type: Gist)
  @@map("sucursales")
}

model Paciente {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  firebase_uid        String?            @unique @db.VarChar(128)
  nombre              String             @db.VarChar(100)
  apellido_paterno    String?            @db.VarChar(100)
  apellido_materno    String?            @db.VarChar(100)
  fecha_nacimiento    DateTime?          @db.Date
  sexo                String?            @db.Char(1)
  email               String?            @unique @db.VarChar(150)
  telefono            String?            @db.VarChar(20)
  latitud_habitual    Decimal?           @db.Decimal(10, 7)
  longitud_habitual   Decimal?           @db.Decimal(10, 7)
  activo              Boolean            @default(true)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @db.Timestamptz(6)
  encuestas           Encuesta[]
  reservacions        Reservacion[]
  resultados_estudios ResultadoEstudio[]

  @@map("pacientes")
}

model Estudio {
  id                           Int                      @id @default(autoincrement())
  nombre                       String                   @unique @db.VarChar(150)
  orden_prioridad              Int                      @default(0)
  tiempo_espera_promedio_min   Int                      @default(20)
  tiempo_atencion_promedio_min Int?
  tiempo_atencion_variable     Boolean                  @default(false)
  requiere_preparacion         Boolean                  @default(false)
  requiere_orden_medica        Boolean                  @default(false)
  max_vigencia_muestra_min     Int?
  control_puntualidad          Boolean                  @default(false)
  descripcion                  String?
  activo                       Boolean                  @default(true)
  created_at                   DateTime                 @default(now()) @db.Timestamptz(6)
  cola_atencion                ColaAtencion[]
  restricciones_edad           EstudioRestriccionEdad[]
  secuencia_primero            EstudioSecuencia[]       @relation("EstudioPrimero")
  secuencia_segundo            EstudioSecuencia[]       @relation("EstudioSegundo")
  historico_promedios          HistoricoPromedio[]
  paquetes_asociados           PaqueteEstudio[]
  predicciones_ia              PrediccionIA[]
  reservaciones_srv            ReservacionServicio[]
  resultados                   ResultadoEstudio[]
  subestudios                  Subestudio[]
  consultorios                 SucursalConsultorio[]

  @@map("estudios")
}

model EstudioRestriccionEdad {
  id                    Int     @id @default(autoincrement())
  id_estudio            Int
  edad_minima           Int?
  edad_maxima           Int?
  requiere_orden_medica Boolean @default(false)
  vigencia_minima_meses Int?
  descripcion           String?
  estudio               Estudio @relation(fields: [id_estudio], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("estudios_restricciones_edad")
}

model EstudioSecuencia {
  id                 Int     @id @default(autoincrement())
  id_estudio_primero Int
  id_estudio_segundo Int
  descripcion        String?
  estudio_primero    Estudio @relation("EstudioPrimero", fields: [id_estudio_primero], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudio_segundo    Estudio @relation("EstudioSegundo", fields: [id_estudio_segundo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_estudio_primero, id_estudio_segundo])
  @@map("estudios_secuencias")
}

model Subestudio {
  id                Int                   @id @default(autoincrement())
  id_estudio        Int
  nombre            String                @db.VarChar(200)
  codigo            String?               @db.VarChar(50)
  activo            Boolean               @default(true)
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  reservaciones_srv ReservacionServicio[]
  estudio           Estudio               @relation(fields: [id_estudio], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("subestudios")
}

model Paquete {
  id          Int              @id @default(autoincrement())
  nombre      String           @db.VarChar(150)
  descripcion String?
  precio      Decimal?         @db.Decimal(10, 2)
  activo      Boolean          @default(true)
  estudios    PaqueteEstudio[]

  @@map("paquetes")
}

model PaqueteEstudio {
  id         Int     @id @default(autoincrement())
  id_paquete Int
  id_estudio Int
  estudio    Estudio @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paquete    Paquete @relation(fields: [id_paquete], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_paquete, id_estudio])
  @@map("paquetes_estudios")
}

model SucursalHorarioEspecial {
  id            Int       @id @default(autoincrement())
  id_sucursal   Int
  fecha         DateTime  @db.Date
  hora_apertura DateTime? @db.Time(6)
  hora_cierre   DateTime? @db.Time(6)
  cerrada       Boolean   @default(false)
  motivo        String?   @db.VarChar(200)
  sucursales    Sucursal  @relation(fields: [id_sucursal], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sucursales_horarios_especiales")
}

model SucursalConsultorio {
  id                 Int                   @id @default(autoincrement())
  id_sucursal        Int
  id_estudio         Int
  cantidad           Int                   @default(1)
  area_nombre        String?               @db.VarChar(100)
  coordenada_interna Json?
  activo             Boolean               @default(true)
  cola_atencion      ColaAtencion[]
  reservaciones_srv  ReservacionServicio[]
  estudio            Estudio               @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales         Sucursal              @relation(fields: [id_sucursal], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_sucursal, id_estudio])
  @@map("sucursales_consultorios")
}

model UsuarioStaff {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  firebase_uid String?       @unique @db.VarChar(128)
  id_sucursal  Int
  nombre       String        @db.VarChar(100)
  apellido     String?       @db.VarChar(100)
  email        String        @unique @db.VarChar(150)
  rol          String        @default("recepcionista") @db.VarChar(50)
  activo       Boolean       @default(true)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  checkins     Reservacion[]
  sucursal     Sucursal      @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("usuarios_staff")
}

model Reservacion {
  id               BigInt                @id @default(autoincrement())
  id_paciente      String                @db.Uuid
  id_sucursal      Int
  fecha_programada DateTime              @db.Date
  hora_programada  DateTime?             @db.Time(6)
  origen           String                @default("recepcion") @db.VarChar(30)
  estado           String                @default("pendiente") @db.VarChar(30)
  checkin_at       DateTime?             @db.Timestamptz(6)
  checkin_tipo     String?               @db.VarChar(30)
  id_staff_checkin String?               @db.Uuid
  finalizada_at    DateTime?             @db.Timestamptz(6)
  notas            String?
  created_at       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at       DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  encuestas        Encuesta[]
  paciente         Paciente              @relation(fields: [id_paciente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_checkin    UsuarioStaff?         @relation(fields: [id_staff_checkin], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales       Sucursal              @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicios        ReservacionServicio[]

  @@index([estado], map: "idx_reservaciones_estado")
  @@index([fecha_programada], map: "idx_reservaciones_fecha")
  @@index([id_paciente], map: "idx_reservaciones_paciente")
  @@index([id_sucursal], map: "idx_reservaciones_sucursal")
  @@map("reservaciones")
}

model ReservacionServicio {
  id                         BigInt               @id @default(autoincrement())
  id_reservacion             BigInt
  id_estudio                 Int
  id_subestudio              Int?
  id_sucursal                Int
  estado                     String               @default("en_espera") @db.VarChar(30)
  numero_turno               Int?
  hora_inicio_espera         DateTime?            @db.Timestamptz(6)
  hora_llamado               DateTime?            @db.Timestamptz(6)
  hora_inicio_atencion       DateTime?            @db.Timestamptz(6)
  hora_fin_atencion          DateTime?            @db.Timestamptz(6)
  tiempo_espera_real_min     Int?
  tiempo_atencion_real_min   Int?
  orden_atencion             Int                  @default(0)
  orden_medica_url           String?
  muestra_valida             Boolean?
  id_consultorio             Int?
  tiempo_espera_predicho_min Int?
  created_at                 DateTime             @default(now()) @db.Timestamptz(6)
  cola_atencion              ColaAtencion[]
  consultorio                SucursalConsultorio? @relation(fields: [id_consultorio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudio                    Estudio              @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservacion                Reservacion          @relation(fields: [id_reservacion], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subestudio                 Subestudio?          @relation(fields: [id_subestudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales                 Sucursal             @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resultados                 ResultadoEstudio[]

  @@index([estado], map: "idx_reser_srv_estado")
  @@index([id_estudio], map: "idx_reser_srv_estudio")
  @@index([id_reservacion], map: "idx_reser_srv_reservacion")
  @@map("reservaciones_servicios")
}

model ColaAtencion {
  id                  BigInt               @id @default(autoincrement())
  id_sucursal         Int
  id_estudio          Int
  id_consultorio      Int?
  id_reservacion_srv  BigInt
  posicion            Int
  estado              String               @default("activo") @db.VarChar(20)
  tiempo_estimado_min Int?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  consultorio         SucursalConsultorio? @relation(fields: [id_consultorio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudio             Estudio              @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservacion_srv     ReservacionServicio  @relation(fields: [id_reservacion_srv], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales          Sucursal             @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_sucursal, id_estudio, posicion], map: "idx_cola_posicion", where: raw("((estado)::text = 'activo'::text)"))
  @@map("cola_atencion")
}

model HistoricoPromedio {
  id              BigInt   @id @default(autoincrement())
  id_sucursal     Int
  id_estudio      Int
  promedio        Decimal  @db.Decimal(8, 2)
  fecha           DateTime @db.Date
  hora_dia        Int?     @db.SmallInt
  dia_semana      Int?     @db.SmallInt
  total_pacientes Int?
  estudio         Estudio  @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales      Sucursal @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha], map: "idx_hist_prom_fecha")
  @@index([id_sucursal, id_estudio], map: "idx_hist_prom_sucursal_estudio")
  @@map("historico_promedios")
}

model PrediccionIA {
  id                     BigInt   @id @default(autoincrement())
  id_sucursal            Int
  id_estudio             Int
  fecha_prediccion       DateTime @db.Date
  hora_prediccion        Int      @db.SmallInt
  tiempo_espera_pred_min Decimal  @db.Decimal(6, 2)
  score_confianza        Decimal? @db.Decimal(5, 4)
  modelo                 String?  @db.VarChar(50)
  nivel_saturacion       String?  @db.VarChar(20)
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  estudio                Estudio  @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursales             Sucursal @relation(fields: [id_sucursal], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha_prediccion, hora_prediccion], map: "idx_pred_ia_fecha_hora")
  @@index([id_sucursal, id_estudio], map: "idx_pred_ia_sucursal_estudio")
  @@map("predicciones_ia")
}

model ResultadoEstudio {
  id                 BigInt              @id @default(autoincrement())
  id_reservacion_srv BigInt
  id_paciente        String              @db.Uuid
  id_estudio         Int
  archivo_url        String?
  archivo_tipo       String?             @db.VarChar(20)
  resumen_ia         String?
  disponible         Boolean             @default(false)
  disponible_at      DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  estudio            Estudio             @relation(fields: [id_estudio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pacientes          Paciente            @relation(fields: [id_paciente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservacion_srv    ReservacionServicio @relation(fields: [id_reservacion_srv], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("resultados_estudios")
}

model Encuesta {
  id                   BigInt      @id @default(autoincrement())
  id_reservacion       BigInt
  id_paciente          String      @db.Uuid
  calificacion_general Int?        @db.SmallInt
  calificacion_espera  Int?        @db.SmallInt
  calificacion_trato   Int?        @db.SmallInt
  calificacion_app     Int?        @db.SmallInt
  comentario           String?
  uso_app_checkin      Boolean     @default(false)
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  pacientes            Paciente    @relation(fields: [id_paciente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservacion          Reservacion @relation(fields: [id_reservacion], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("encuestas")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
